# Maintainer: CutZone contributors
pkgname=cutzone
pkgver=${CONCAT_VERSION:?CONCAT_VERSION must be set}
pkgrel=1
pkgdesc="Free and open source video editor"
arch=('x86_64' 'aarch64')
url="https://github.com/mr-socialmedia/cutzone"
license=('AGPL-3.0-or-later')
depends=('glibc' 'gtk3' 'fontconfig' 'freetype2' 'libxkbcommon' 'mesa' 'alsa-lib')
options=('!strip' '!debug')
source=()

stage=${CONCAT_STAGE:?CONCAT_STAGE must point at the staged folder}

package() {
  install -Dm755 "$stage/cutzone" "$pkgdir/opt/cutzone/cutzone"
  install -d "$pkgdir/opt/cutzone/lib"
  cp -a "$stage"/lib/. "$pkgdir/opt/cutzone/lib/"

  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /opt/cutzone/cutzone "$@"\n' > "$pkgdir/usr/bin/cutzone"
  chmod 755 "$pkgdir/usr/bin/cutzone"
  install -Dm644 "$stage/cutzone.desktop" "$pkgdir/usr/share/applications/cutzone.desktop"
  sed -i 's|^Exec=cutzone|Exec=/opt/cutzone/cutzone %U|' "$pkgdir/usr/share/applications/cutzone.desktop"
  install -Dm644 "$stage/cutzone.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/cutzone.png"

  install -Dm644 "$stage/LICENSE" "$pkgdir/usr/share/licenses/cutzone/LICENSE"
  install -Dm644 "$stage/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/cutzone/THIRD_PARTY_NOTICES.md"
}
