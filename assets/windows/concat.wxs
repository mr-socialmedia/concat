<?xml version="1.0" encoding="UTF-8"?>
<!--
  CutZone's Windows Installer package, the .msi beside the Inno Setup .exe.

  Built by build-app.yml with WiX from the staged folder the .exe is made
  of, so the two installers ship the same files. The .exe is the
  one a person double-clicks; this is the one an administrator deploys -
  Group Policy, Intune, winget - and it installs for the machine, into
  Program Files, with a Start menu entry and a clean uninstall. Handed in:

    wix build -arch x64 -d Version=0.2.9 -d Root=C:\...\CutZone
              -d Stage=C:\...\stage\CutZone-0.2.9-windows-x86_64
              -o stage\CutZone-0.2.9-windows-x86_64.msi assets\windows\concat.wxs

  Root is the repository: WiX resolves a source path against where it is
  run from, not against this file.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- One upgrade code for the life of the product, so a newer .msi
       replaces an older one rather than sitting beside it. -->
  <Package Name="CutZone"
           Manufacturer="CutZone contributors"
           Version="$(var.Version)"
           UpgradeCode="E8AF13D1-AF53-47EC-97D0-789F71D9F43F"
           Scope="perMachine"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of CutZone is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="concat.ico" SourceFile="$(var.Root)\assets\icons\concat.ico" />
    <Property Id="ARPPRODUCTICON" Value="concat.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mr-socialmedia/concat" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CutZone" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="CutZone" />
    </StandardDirectory>

    <Feature Id="Main" Title="CutZone" Level="1">
      <ComponentGroupRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <!-- Every file in the staged folder, as it is there. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)\**" />
    </ComponentGroup>

    <Component Id="StartMenu" Directory="ShortcutFolder" Guid="EED810A9-403B-4504-8864-2F099C7734B7">
      <Shortcut Id="StartMenuShortcut"
                Name="CutZone"
                Description="Video editor"
                Target="[INSTALLFOLDER]cutzone.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concat.ico" />
      <!-- The way in when a graphics driver draws the window as coloured
           squares: it turns off Settings > General > Draw on the GPU,
           which that window hides. -->
      <Shortcut Id="SafeGraphicsShortcut"
                Name="CutZone (safe graphics)"
                Description="CutZone, drawn in software"
                Target="[INSTALLFOLDER]cutzone.exe"
                Arguments="--software"
                WorkingDirectory="INSTALLFOLDER"
                Icon="concat.ico" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\CutZone" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
